# AdMaven Data Pipeline Environment Variables

# Data directory path (default: ./data relative to src/)
DATA_DIR=/path/to/data

# API key for AdMaven similar sites API
API_KEY=your_api_key_here

# HuggingFace token for LLM ad detection (optional)
HF_TOKEN=your_hf_token_here

# API endpoint for similar sites (default provided)
SIMILAR_SITES_API_URL=http://leads-management.ad-maven.com:9777/similar_get_domains

# Z-score threshold for fraud detection (default: -1.96)
Z_SCORE_THRESHOLD=-1.96
